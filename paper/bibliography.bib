@article{kieuDevelopmentValidationMachine2024,
  title = {Development and Validation of Machine Learning-Based Predictive Clinical Decision Support System for Olanzapine in Patients with Schizophrenia},
  author = {Kieu, Anh Mai and Dang, Ha Nguyet and Tran, Khanh Thi Cat and Nguyen, Tuyen Thi Thanh and Nguyen, Chien Huu and Nguyen, Thanh Chi and Pham, Huong Thu and Le, Jennifer and Nguyen, Hai Thanh},
  year = 2024,
  journal = {Pharmaceutical Sciences Asia},
  volume = {51},
